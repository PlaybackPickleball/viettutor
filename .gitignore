# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/qa-reports/playwright-html/
/qa-reports/test-results/
/qa-reports/playwright-results.json
/test-results/
/playwright-report/
# Keep committed markdown summaries under qa-reports/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
vie.traineddata

# ÁMi Sing — keep scratch / private copies out of git
/private-media/
/local-media/
/sing-local/
public/sing/private/
/data/karaoke/uploads/
/data/karaoke/stems/
/data/karaoke/align/
# Keep approved JSON when present; ignore runtime noise
/data/karaoke/*.log

# Ignore MP3s by default; allow only licensed demo masters we intentionally ship
# (under data/sing/masters — never public/sing, which is statically downloadable)
*.mp3
*.MP3
!data/sing/masters/*.wav
!data/sing/masters/ngay-mai-nguoi-ta-lay-chong.mp3
!data/sing/masters/hat-mua-vuong-van.mp3
!data/sing/masters/xin-chao-moi-ngay.wav
# VLA-109 alphabet letter clips (ElevenLabs Thanh Ngọc) — Nicola approved; studio gated by
# ALPHABET_LETTER_AUDIO_ENABLED in src/lib/alphabetAudio.ts.
!public/audio/vi/alphabet/*.mp3
!public/audio/vi/alphabet/source/*.mp3
# VLA-110 First-100 vocab clips — Nicola approved; pack Hear gated by
# VOCAB_PACK_AUDIO_ENABLED in src/lib/vocabulary/audio.ts.
!public/audio/vi/vocabulary/*.mp3
!public/audio/vi/vocabulary/source/*.mp3
# Essential Sentences Lesson 1 voiceovers — gated by SENTENCE_NATIVE_AUDIO_ENABLED.
!public/audio/vi/sentences/*.mp3
