# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
vie.traineddata

# ÁMi Sing — keep scratch / private copies out of git
/private-media/
/local-media/
/sing-local/
public/sing/private/
/data/karaoke/uploads/
/data/karaoke/stems/
/data/karaoke/align/
# Keep approved JSON when present; ignore runtime noise
/data/karaoke/*.log

# Ignore MP3s by default; allow only licensed demo masters we intentionally ship
*.mp3
*.MP3
!public/sing/*.wav
!public/sing/ngay-mai-nguoi-ta-lay-chong.mp3
!public/sing/hat-mua-vuong-van.mp3
