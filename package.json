{
  "name": "ami-lingua",
  "version": "0.1.0",
  "private": true,
  "description": "ÁMi Lingua — AI Vietnamese Learning Studio (Level 1 MVP)",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test --project=desktop-chrome e2e/journey-a-new-student.spec.ts e2e/journey-b-returning.spec.ts e2e/journey-c-pronunciation.spec.ts e2e/journey-d-karaoke.spec.ts e2e/journey-e-english.spec.ts e2e/smoke-routes.spec.ts",
    "test:qa": "node scripts/run-qa.mjs",
    "test:qa:report": "node scripts/qa-report.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
