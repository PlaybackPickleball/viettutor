# Optional — ÁMi Lingua runs without these (Tesseract OCR + localStorage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Google Cloud Vision (server /api/ocr). Without it, Scan uses on-device Tesseract.
GOOGLE_CLOUD_VISION_API_KEY=

# Optional Azure Speech Pronunciation Assessment (Phase 2). Without it, scoring stays unavailable.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
