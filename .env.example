# Optional — ÁMi Lingua runs without these (Tesseract OCR + localStorage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Azure Speech Pronunciation Assessment (server-only). Without it, scoring stays unavailable.
# Same key scores American English (en-US) and Vietnamese (vi-VN) via /api/english/assess and /api/vi/assess.
# Browser WebM takes are re-encoded to WAV on the client before VI assess when needed.
# Do not wire a public OCR proxy to cloud Vision without authenticated sessions.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional server-only key for the English teacher's one correction and confirmed-text translation.
# Never expose this to the browser. The English course still runs with scripted lessons when it is empty.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
