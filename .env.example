# Optional — ÁMi Lingua runs without these (Tesseract OCR + localStorage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Azure Speech Pronunciation Assessment (Phase 2). Without it, scoring stays unavailable.
# The same server-side key can score American English (en-US) when both values are set.
# This build only sends WAV or OGG to Azure. Typical browser WebM recordings are not scored.
# Do not wire a public OCR proxy to cloud Vision without authenticated sessions.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional server-only key for the English teacher's one correction and confirmed-text translation.
# Never expose this to the browser. The English course still runs with scripted lessons when it is empty.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
