# Optional — ÁMi Lingua runs without these (Tesseract OCR + localStorage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Deepgram Vietnamese transcription for /api/vi/assess (server-only).
# Compares recognized text to expected word (diacritics preserved). Never used as a pronunciation %.
# Browser WebM takes are re-encoded to WAV on the client when needed.
DEEPGRAM_API_KEY=

# Optional Azure Speech for English phoneme assessment only (/api/english/assess).
# Not used for Vietnamese assess after the Deepgram swap.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional server-only key for the English teacher's one correction and confirmed-text translation.
# Never expose this to the browser. The English course still runs with scripted lessons when it is empty.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
